# ============================================================
# .env.example — copy ไฟล์นี้แล้วตั้งชื่อเป็น .env
# จากนั้นแก้ไขค่าให้ตรงกับ environment ของคุณ
# ============================================================

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/asset_db"

# Authentication (Better-Auth)
# สร้าง secret ด้วยคำสั่ง: openssl rand -base64 32
BETTER_AUTH_SECRET="your-random-secret-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (SMTP)
# Gmail: เปิด 2-Step Verification ก่อน แล้วสร้าง App Password ที่
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="noreply@yourdomain.com"

# Admin Setup (ใช้ตอนรัน: npx tsx scripts/setup-system.tsx)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# Storage — ใช้ local filesystem (public/uploads/)
STORAGE_PROVIDER=local
